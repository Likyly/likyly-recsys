{
  "name": "@likyly/react",
  "version": "0.2.2",
  "description": "LIKYLY product recommendations for React and Next.js: a ready-made component and a hook, with impressions and clicks tracked for you.",
  "keywords": [
    "likyly",
    "react",
    "nextjs",
    "recommendations",
    "product recommendations",
    "personalization",
    "ecommerce",
    "hooks"
  ],
  "homepage": "https://www.likyly.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Likyly/likyly-recsys.git",
    "directory": "sdk/react"
  },
  "bugs": {
    "url": "https://github.com/Likyly/likyly-recsys/issues"
  },
  "author": "LIKYLY (https://www.likyly.com)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "rm -rf dist/test && tsc -p tsconfig.test.json && node --test \"dist/test/test/*.test.js\""
  },
  "dependencies": {
    "@likyly/sdk": "^1.1.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.5.4"
  }
}
