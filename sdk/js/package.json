{
  "name": "@likyly/sdk",
  "version": "1.1.1",
  "description": "Product recommendations for your site (\"You may also like\", \"Recommended for you\"), learned from what your visitors do. Official LIKYLY client for JavaScript and TypeScript: browser, Node.js, edge.",
  "keywords": [
    "likyly",
    "recommendations",
    "product recommendations",
    "recommender",
    "personalization",
    "ecommerce",
    "you may also like",
    "typescript"
  ],
  "homepage": "https://www.likyly.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Likyly/likyly-recsys.git",
    "directory": "sdk/js"
  },
  "bugs": {
    "url": "https://github.com/Likyly/likyly-recsys/issues"
  },
  "author": "LIKYLY (https://www.likyly.com)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/esm",
    "dist/cjs",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/mark-cjs.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "rm -rf dist/test && tsc -p tsconfig.test.json && node --test \"dist/test/test/*.test.js\"",
    "example": "npm run build && node examples/quickstart.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.4"
  }
}
