{
    "name": "likyly/sdk",
    "description": "Official LIKYLY SDK for PHP: items, users, events and recommendations.",
    "type": "library",
    "license": "MIT",
    "keywords": ["recommendations", "recommender", "personalization", "likyly"],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "squizlabs/php_codesniffer": "^3.10",
        "phpstan/phpstan": "^1.11"
    },
    "autoload": {
        "psr-4": { "Likyly\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Likyly\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs --standard=PSR12 src tests",
        "analyse": "phpstan analyse -c phpstan.neon"
    },
    "config": { "sort-packages": true }
}
