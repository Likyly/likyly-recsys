<?xml version="1.0"?>
<ruleset name="LIKYLY PHP SDK">
    <description>PSR-12, with the line length this SDK is written at (its signatures and messages are long on purpose, like the other LIKYLY SDKs).</description>
    <file>src</file>
    <file>tests</file>
    <rule ref="PSR12"/>
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="220"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>
</ruleset>
