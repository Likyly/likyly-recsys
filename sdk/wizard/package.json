{
  "name": "@likyly/wizard",
  "version": "0.9.2",
  "description": "Add LIKYLY product recommendations to your project in one command: detects your framework, installs the SDK, writes your key and connects your AI coding assistant.",
  "keywords": [
    "likyly",
    "recommendations",
    "installer",
    "cli",
    "setup",
    "mcp",
    "claude-code",
    "cursor",
    "ecommerce"
  ],
  "homepage": "https://www.likyly.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Likyly/likyly-recsys.git",
    "directory": "sdk/wizard"
  },
  "bugs": {
    "url": "https://github.com/Likyly/likyly-recsys/issues"
  },
  "author": "LIKYLY (https://www.likyly.com)",
  "type": "module",
  "bin": {
    "likyly-wizard": "./bin/likyly-wizard.mjs",
    "wizard": "./bin/likyly-wizard.mjs"
  },
  "files": [
    "bin",
    "dist",
    "skill"
  ],
  "scripts": {
    "build": "node build.mjs",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build && mkdir -p skill && cp ../../docs/SKILL.md skill/SKILL.md"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "ink": "^8.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.3.1"
  }
}
