# Copy to hoppscotch.env on the droplet (outside git, same pattern as
# application/api/.env) and fill in real values. Never commit hoppscotch.env.

# Dedicated Postgres for Hoppscotch only - not the recsys-api database.
# Both vars must hold the same value: POSTGRES_PASSWORD is the postgres
# image's own required name (hoppscotch-db reads this file via env_file too),
# HOPPSCOTCH_DB_PASSWORD is only used below, in DATABASE_URL.
HOPPSCOTCH_DB_PASSWORD=change-me
POSTGRES_PASSWORD=change-me

DATABASE_URL=postgresql://postgres:change-me@hoppscotch-db:5432/hoppscotch

# Must be exactly 32 characters. Generate with: openssl rand -hex 16
DATA_ENCRYPTION_KEY=00000000000000000000000000000000

# Single-domain deployment behind Caddy: the aio image proxies backend/admin
# under subpaths of the same origin so only one Caddy route (port 3000) is
# needed. See https://docs.hoppscotch.io for the current subpath contract.
ENABLE_SUBPATH_BASED_ACCESS=true
VITE_BASE_URL=https://hoppscotch.likyly.com
VITE_SHORTCODE_BASE_URL=https://hoppscotch.likyly.com
VITE_ADMIN_URL=https://hoppscotch.likyly.com/admin
VITE_BACKEND_GQL_URL=https://hoppscotch.likyly.com/backend/graphql
VITE_BACKEND_WS_URL=wss://hoppscotch.likyly.com/backend/graphql
VITE_BACKEND_API_URL=https://hoppscotch.likyly.com/backend/v1
WHITELISTED_ORIGINS=https://hoppscotch.likyly.com
TRUST_PROXY=true
