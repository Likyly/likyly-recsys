# Copy to apisix.env on the droplet (outside git, same pattern as
# application/api/.env and hoppscotch.env). Never commit apisix.env.

# Generate with: openssl rand -hex 32
# Do NOT use the well-known example key from the APISIX docs
# (edd1c9f034335f136f87ad84b625c8f...) - it's public, publishing routes/
# plugins to production APISIX with it is equivalent to no auth at all.
ADMIN_KEY=change-me
